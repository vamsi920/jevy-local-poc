# ---- LLM provider -------------------------------------------------------------------------
# ollama (local, default) or openai (any OpenAI-compatible API: OpenAI, Azure OpenAI, vLLM, TGI,
# LiteLLM, Bedrock/Vertex gateways, self-hosted GPU endpoints).
LLM_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:0.6b
# For LLM_PROVIDER=openai:
# LLM_BASE_URL=https://llm-gateway.example.com/v1
# LLM_API_KEY=...
# LLM_MODEL=qwen2.5-32b-instruct
# LLM_HEADERS={"X-Tenant":"acme"}
# Remote endpoints rarely report model size/capabilities; set them so the right strategy is used.
# LLM_PARAMS_B=32
# LLM_CONTEXT_LENGTH=32768
# LLM_CAPABILITIES=tools            # add ",thinking" if the endpoint can toggle reasoning
# LLM_REASONING=none                # none | effort (reasoning_effort) | chat_template (vLLM enable_thinking)
# LLM_JSON_MODE=auto                # auto | json_schema | json_object | prompt
# LLM_CONCURRENCY=4                 # max parallel calls to the endpoint
# Learn table notes and synonyms in the background with the configured model (on|off).
SCHEMA_NOTES=on
BACKEND_PORT=3001
FRONTEND_PORT=5173
DB_PATH=./data/jevy.duckdb
SEED=42
DATA_AS_OF=2026-10-07
MAX_ROWS=200
# Per-query timeout. Aggregations over tens of millions of rows may need more.
SQL_TIMEOUT_MS=30000
# DuckDB resources; queries that exceed memory spill to a temp directory instead of failing.
DB_MEMORY_LIMIT=2GB
DB_THREADS=4
# Background schema profiling timeout, and the table size above which profiles use a 2M-row sample.
PROFILE_TIMEOUT_MS=300000
PROFILE_SAMPLE_ABOVE_ROWS=50000000
LLM_TIMEOUT_MS=180000

# Hard ceiling per question (max 600000). The budget grows with the endpoint's measured latency up to this.
REQUEST_TIMEOUT_MS=300000
# Per model call timeout, and retries (with backoff, honouring Retry-After) for 429/5xx/connection resets.
# LLM_RETRIES=4
# Optional: force a strategy tier (tiny | small | large) instead of detecting it from model size.
# AGENT_TIER=
# Optional business hints (synonyms, definitions). The agent also works without this file.
SEMANTIC_PATH=./data/semantic.json
# Tip: start Ollama with OLLAMA_NUM_PARALLEL=2 so parallel SQL candidates run concurrently.

# Re-profile schema, values, joins and re-learn schema notes once a day while the app runs.
SCHEMA_REFRESH_MS=86400000
# Cheap check for a replaced/changed database file; a change triggers an immediate rebuild.
SCHEMA_CHANGE_CHECK_MS=300000
